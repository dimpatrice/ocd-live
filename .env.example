# =============================================================================
# OCD LIVE — BOOVAN GROUP
# Fichier de configuration d'environnement exemple (.env.example)
# Copiez ce fichier en ".env" et personnalisez les valeurs pour la production
# =============================================================================

# Port du serveur API et Back-Office
PORT=3006

# Clé secrète JWT pour l'authentification administrateur (à changer en production)
JWT_SECRET=OCD_LIVE_BOOVAN_GROUP_ULTRA_SECRET_KEY_2026_CHANGE_ME

# Identifiants Administrateur Initiaux (créés au premier démarrage)
ADMIN_INITIAL_EMAIL=direction@boovangroup.com
ADMIN_INITIAL_PASSWORD=OcdLive@Boovan2026!

# Fuseau horaire officiel du studio (Togo)
STUDIO_TIMEZONE=Africa/Lome

# Configuration SMTP optionnelle pour l'envoi d'e-mails transactionnels en direct
# (Si non renseignée, toutes les notifications et e-mails complets sont enregistrés
# et consultables dans le Centre de Notifications du Back-Office Administrateur)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OCD LIVE — Boovan Group <reservations@boovangroup.com>"
